<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Versión de Revit de destino (2021–2026).
         Cámbiala aquí, o compila con:  dotnet build -c Release -p:RevitVersion=2025 -->
    <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>

    <!-- Revit 2021–2024 usan .NET Framework 4.8; Revit 2025+ usa .NET 8 -->
    <TargetFramework>net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' &gt;= '2025'">net8.0-windows</TargetFramework>

    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MJAlignTools</AssemblyName>
    <RootNamespace>MJAlignTools</RootNamespace>
    <Version>1.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ensamblados de la API de Revit (solo para compilar; en ejecución los provee Revit) -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
  </ItemGroup>

  <!-- Despliegue automático: al compilar en Windows copia la DLL y el .addin
       a la carpeta de add-ins de Revit del usuario actual.
       En CI se desactiva con -p:SkipAddinDeploy=true -->
  <Target Name="DeployAddin" AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT' AND '$(SkipAddinDeploy)' != 'true'">
    <PropertyGroup>
      <RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\</RevitAddinsDir>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(RevitAddinsDir)MJAlignTools\" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\manifest\MJAlignTools.addin" DestinationFolder="$(RevitAddinsDir)" />
    <Message Importance="high" Text="Add-in desplegado en: $(RevitAddinsDir)" />
  </Target>

</Project>
