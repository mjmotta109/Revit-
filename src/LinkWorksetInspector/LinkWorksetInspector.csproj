<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Versión de Revit de destino (2021–2026).
         Cámbiala aquí, o compila con:  dotnet build -c Release -p:RevitVersion=2025 -->
    <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>

    <!-- Revit 2021–2024 usan .NET Framework 4.8; Revit 2025+ usa .NET 8 -->
    <TargetFramework>net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' &gt;= '2025'">net8.0-windows</TargetFramework>

    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>LinkWorksetInspector</AssemblyName>
    <RootNamespace>LinkWorksetInspector</RootNamespace>
    <Version>1.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ensamblados de la API de Revit: solo para compilar (en ejecución los provee Revit),
         por eso ExcludeAssets=runtime evita copiarlos a la salida -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />

    <!-- SDK oficial de Anthropic (asistente IA). Sus DLL sí deben copiarse junto al add-in. -->
    <PackageReference Include="Anthropic" Version="*" />
  </ItemGroup>

  <!-- Despliegue automático: al compilar en Windows copia el add-in con todas sus
       dependencias (SDK de Anthropic incluido) y el .addin a la carpeta de add-ins -->
  <Target Name="DeployAddin" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\</RevitAddinsDir>
    </PropertyGroup>
    <ItemGroup>
      <AddinOutput Include="$(TargetDir)**\*.dll;$(TargetDir)**\*.pdb;$(TargetDir)**\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(AddinOutput)" DestinationFolder="$(RevitAddinsDir)LinkWorksetInspector\%(RecursiveDir)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\manifest\LinkWorksetInspector.addin" DestinationFolder="$(RevitAddinsDir)" />
    <Message Importance="high" Text="Add-in desplegado en: $(RevitAddinsDir)" />
  </Target>

</Project>
